name: Update KSU Submodule to Specific Commit

on:
  workflow_dispatch:
  push: 
jobs:
  update-ksu:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          ref: Noroot2
          submodules: true
          fetch-depth: 0
          token: ${{ secrets.PUSH }}

      - name: Configure Git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Update Submodule Commit
        run: |
          cd KernelSU-Next
          git fetch origin f110cddc07e27b21ad77c6c31261660efb25dce4
          git checkout f110cddc07e27b21ad77c6c31261660efb25dce4
          cd ..

      - name: Commit and Push Submodule Changes
        run: |
          git add KernelSU-Next
          if git diff --staged --quiet; then
            echo "Submodule is already pointing to commit f110cddc07e27b21ad77c6c31261660efb25dce4"
          else
            git commit -m "submodule: update KernelSU-Next to commit f110cddc07e27b21ad77c6c31261660efb25dce4"
            git push origin HEAD:Noroot2
          fi
